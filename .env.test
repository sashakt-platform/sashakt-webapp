# These are placeholders so `vitest` and CI which has no .env can start.
# SvelteKit 3 validates every variable declared in src/env.ts at startup, and
# Vite loads this file only for mode=test - a production build still reads .env
# and still fails loudly if BACKEND_URL is missing.
#
# Unit tests mock `$env/static/private`, so these values are never called.
BACKEND_URL=http://localhost:8000/api/v1
PUBLIC_APP_ENV=development
